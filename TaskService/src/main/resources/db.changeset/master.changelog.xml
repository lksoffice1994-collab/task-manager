<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- 
        MASTER CHANGELOG
        This file orchestrates all schema changes via <include> or <includeAll>.
        Place individual table, DDL, or SQL changesets in subfolders (e.g., db.changeset/sql/)
        and include them below.
        Here, we use an SQL-based migration for the tasks entity.
    -->

    <includeAll path="db.changeset/sql" relativeToChangelogFile="false"/>
</databaseChangeLog>
